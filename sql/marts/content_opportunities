CREATE OR REPLACE TABLE ANALYTICS_PORTFOLIO.MARTS.MART_CONTENT_OPPORTUNITIES AS

WITH base AS (
    SELECT *
    FROM ANALYTICS_PORTFOLIO.MARTS.MART_CONTENT_PERFORMANCE
),

percentiles AS (
    SELECT
        PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY PAGEVIEWS) AS P75_PAGEVIEWS,
        PERCENTILE_CONT(0.90) WITHIN GROUP (ORDER BY PAGEVIEWS) AS P90_PAGEVIEWS,
        PERCENTILE_CONT(0.75) WITHIN GROUP (ORDER BY COMMISSIONS) AS P75_COMMISSIONS,
        PERCENTILE_CONT(0.90) WITHIN GROUP (ORDER BY COMMISSIONS) AS P90_COMMISSIONS
    FROM base
)

SELECT
    b.*,

    CASE
        WHEN b.PAGEVIEWS >= p.P90_PAGEVIEWS AND b.COMMISSIONS = 0
            THEN 'Very High Traffic / No Revenue'

        WHEN b.PAGEVIEWS >= p.P75_PAGEVIEWS AND b.COMMISSIONS = 0
            THEN 'High Traffic / No Revenue'

        WHEN b.PAGEVIEWS >= p.P75_PAGEVIEWS 
             AND b.COMMISSIONS > 0 
             AND b.COMMISSIONS < p.P75_COMMISSIONS
            THEN 'High Traffic / Low Revenue'

        WHEN b.PAGEVIEWS < p.P75_PAGEVIEWS 
             AND b.COMMISSIONS >= p.P90_COMMISSIONS
            THEN 'Lower Traffic / Very High Revenue'

        WHEN b.PAGEVIEWS >= p.P75_PAGEVIEWS 
             AND b.COMMISSIONS >= p.P75_COMMISSIONS
            THEN 'High Traffic / High Revenue'

        ELSE 'Other'
    END AS OPPORTUNITY_TYPE

FROM base b
CROSS JOIN percentiles p;
