CREATE OR REPLACE TABLE ANALYTICS_PORTFOLIO.MARTS.MART_MONTHLY_CONTENT_PERFORMANCE AS

SELECT
    DATE_TRUNC('MONTH', DATE) AS MONTH,

    CLEAN_URL,

    SUM(SESSIONS) AS TOTAL_SESSIONS,
    SUM(PAGEVIEWS) AS TOTAL_PAGEVIEWS,

    SUM(COMMISSIONS) AS TOTAL_COMMISSIONS,
    SUM(SALES) AS TOTAL_SALES,
    SUM(NUMBER_OF_ORDERS) AS TOTAL_ORDERS,

    ROUND(
        (SUM(COMMISSIONS) / NULLIF(SUM(PAGEVIEWS), 0)) * 1000,
        2
    ) AS RPM,

    ROUND(
        SUM(COMMISSIONS) / NULLIF(SUM(SALES), 0),
        4
    ) AS COMMISSION_RATE,

    ROUND(
        SUM(NUMBER_OF_ORDERS) / NULLIF(SUM(SESSIONS), 0),
        4
    ) AS ORDERS_PER_SESSION

FROM ANALYTICS_PORTFOLIO.MARTS.MART_CONTENT_PERFORMANCE

GROUP BY
    DATE_TRUNC('MONTH', DATE),
    CLEAN_URL;

    SELECT COUNT(*)
    FROM ANALYTICS_PORTFOLIO.MARTS.MART_MONTHLY_CONTENT_PERFORMANCE;
